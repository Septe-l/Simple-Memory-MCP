# ここの値が使われるのは「設定がまだ DB に保存されていないとき」だけです。
# 一度 WebUI で保存すると DB の値が優先されます。
# compose を書き換えて反映したいときは、WebUI の「既定値に戻す」を押してください。

# --- サーバー ---
MEMORY_MCP_HOST=0.0.0.0
MEMORY_MCP_PORT=8080
# Docker では /data/memory.db (volume)
MEMORY_DB_PATH=data/memory.db

# --- 埋め込みバックエンド ---
# OpenAI 互換の /embeddings を提供するサーバー。
# LM Studio でも llama.cpp の llama-server でも可。
# Docker からホストの LM Studio を見る場合: http://host.docker.internal:1234/v1
# 別マシン (Embedding 専用機) の場合    : http://192.168.1.20:1234/v1
EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_API_KEY=

# --- 主空間: 多言語モデル 1 つで日本語・英語の両方をカバーする ---
EMBEDDING_PRIMARY_MODEL=text-embedding-multilingual-e5-large-instruct
EMBEDDING_PRIMARY_LANGUAGE=multilingual
# EMBEDDING_PRIMARY_BASE_URL=http://192.168.1.20:1234/v1
# 接頭辞はモデル名から自動判別する。上書きしたい場合のみ指定。
# EMBEDDING_PRIMARY_QUERY_PREFIX="query: "
# EMBEDDING_PRIMARY_DOCUMENT_PREFIX="passage: "

# --- 副空間: 言語特化モデルを別サーバーで併用したいときだけ有効にする ---
#
# ⚠ 既定で無効。日英混在の記憶に対する実測では、多言語モデル単独で 14/16 だった
#   正解率が、英語特化モデルを併用すると 10/16 に下がりました。
#   言語特化モデルは自分の言語以外の記憶に対してノイズになります。
EMBEDDING_SECONDARY_ENABLED=false
EMBEDDING_SECONDARY_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_SECONDARY_LANGUAGE=en
# EMBEDDING_SECONDARY_BASE_URL=http://192.168.1.30:8081/v1

# 埋め込み生成のタイムアウト (ミリ秒)
EMBEDDING_TIMEOUT_MS=60000

# --- 検索スコアの重み ---
# SEMANTIC_WEIGHT=1.0
# KEYWORD_WEIGHT=1.0

# --- 会話内容を記憶する度合い (1〜5) ---
#   1 核心のみ       (重要度5以上を保存)
#   2 重要なことだけ  (重要度4以上)
#   3 標準           (重要度3以上)  ← 既定
#   4 細かめ         (重要度2以上)
#   5 ほぼ全部       (重要度1以上)
MEMORY_LEVEL=3
